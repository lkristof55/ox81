{
  "name": "ox81",
  "version": "0.1.0",
  "description": "Byte-exact X-ray for Solana transactions: legacy, v0 and v1 (0x81). Every byte labelled, linted and censused, with zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Ox81 contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkristof55/ox81.git"
  },
  "homepage": "https://github.com/lkristof55/ox81#readme",
  "keywords": [
    "solana",
    "transaction",
    "v1",
    "simd-0385",
    "decoder",
    "wire-format",
    "compute-budget",
    "lint",
    "byte-map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "bin": {
    "ox81": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "bench": "node bench/bench.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "cli": "node src/cli.ts",
    "record": "node scripts/record.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
