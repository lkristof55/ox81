# Copy to app/.env for local runs (scripts/dev.mjs and test/record.mjs read it; the shell env wins).
# On Netlify, set the same names under Site configuration -> Environment variables. On Cloudflare, `npx wrangler@4 secret
# put <NAME>` (locally: app/.dev.vars, gitignored). Never commit values.

# Helius mainnet RPC key (read-only calls: getSlot, getBlock, getTransaction). Required unless SOLANA_RPC_URL is set.
HELIUS_API_KEY=

# Optional: a full RPC URL that replaces Helius entirely (must serve getBlock with maxSupportedTransactionVersion 1).
SOLANA_RPC_URL=

# Optional: the coin's mint address once it exists; /api/health returns it as tokenMint (null while empty).
TOKEN_MINT=

# Optional: only reported as a boolean by /api/health (keys.birdeye); no endpoint calls Birdeye.
BIRDEYE_API_KEY=

# Cloudflare Workers only (wrangler.jsonc sets it to 1): the Workers Free plan budget. The census cron then reads each
# block over several runs (fetch, one page of txs per run, publish) and asks the RPC for an uncompressed block. 0 or unset = whole block per run.
CF_FREE_PLAN=

# Optional: transactions decoded per cron run in that split mode (default 100 under CF_FREE_PLAN=1; 0 = whole block per run).
CENSUS_TXS_PER_RUN=

# Optional, Cloudflare only: /api/census and /api/featured flag stale=true when the newest block is older than this many seconds (default 1200).
CENSUS_STALE_SEC=

# Local only: folder for the JSON file store that replaces Netlify Blobs. scripts/dev.mjs defaults it to app/.data.
# Leave unset on Netlify (the functions then use Netlify Blobs).
LOCAL_STORE_DIR=
